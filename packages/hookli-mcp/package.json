{
  "name": "hookli-mcp",
  "version": "0.2.0",
  "description": "Official Model Context Protocol (MCP) server for hookli React hooks library",
  "bin": {
    "hookli-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "gen:catalog": "node ../../scripts/build-mcp-catalog.mjs",
    "prebuild": "node ../../scripts/build-mcp-catalog.mjs",
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:package": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run test:package"
  },
  "keywords": [
    "hookli",
    "mcp",
    "model-context-protocol",
    "react",
    "react-hooks",
    "ai",
    "agents"
  ],
  "author": "Saif Mohamed",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
