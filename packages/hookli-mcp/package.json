{
  "name": "hookli-mcp",
  "version": "0.1.0",
  "description": "Official Model Context Protocol (MCP) server for hookli React hooks library",
  "bin": {
    "hookli-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "hookli",
    "mcp",
    "model-context-protocol",
    "react",
    "react-hooks",
    "ai",
    "agents"
  ],
  "author": "Saif Mohamed",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0"
  }
}
