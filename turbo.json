{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "hookli#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/gen-hook-sources.mjs",
        "$TURBO_ROOT$/apps/docs/lib/hook-docs.ts"
      ],
      "outputs": [
        "dist/**",
        "generated/**",
        "$TURBO_ROOT$/apps/docs/lib/hook-sources.generated.ts"
      ]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "hookli-mcp#test": {
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["build"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    }
  }
}
